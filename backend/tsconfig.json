{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/utils/auditoria.js",
    "src/utils/crypto.js",
    "src/utils/dinheiro.js",
    "src/utils/cartoesCredito.js",
    "src/utils/carteiras.js",
    "src/utils/comprasParceladas.js",
    "src/utils/despesasFixas.js",
    "src/utils/lancamentosRecorrentes.js",
    "src/utils/sessao.js"
  ]
}
